[Unit]
Description=AutoSL Autonomous Quantitative Trading Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/autosl
EnvironmentFile=-/home/ubuntu/autosl/.env
Environment="TZ=Asia/Kolkata"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/autosl/venv/bin/python3 main.py --config config/config.yaml
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening & limits
LimitNOFILE=65536
StandardOutput=append:/home/ubuntu/autosl/logs/autosl_service.log
StandardError=append:/home/ubuntu/autosl/logs/autosl_service.error.log

[Install]
WantedBy=multi-user.target
