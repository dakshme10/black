# ==============================================================================
# ROOSTOO AUTONOMOUS QUANT BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure with your official credentials.
# NEVER commit your actual .env file or API credentials to Git.

# --- Roostoo Mock Exchange API Credentials ---
ROOSTOO_API_KEY=YOUR_ROOSTOO_API_KEY_HERE
ROOSTOO_SECRET_KEY=YOUR_ROOSTOO_SECRET_KEY_HERE
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# --- Execution Safety Mode ---
# DRY_RUN: When true, bot observes market, generates signals, models risk, but DOES NOT send live orders
DRY_RUN=true

# LIVE_TRADING_ENABLED: Explicit safety gate required for real order placement
# Must be set to true AND DRY_RUN must be false to place actual orders
LIVE_TRADING_ENABLED=false

# --- Portfolio & Execution Constraints ---
INITIAL_WALLET_USD=100000.0
MIN_CASH_RESERVE_PCT=0.05
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DRAWDOWN_PCT=0.06
ROLLING_24H_DRAWDOWN_PCT=0.035

# --- Target Pairs (Comma-separated) ---
TARGET_PAIRS=BTC/USD,ETH/USD

# --- Audit Logging & Hash Integrity ---
ENABLE_HASH_CHAIN=true
LOG_LEVEL=INFO
