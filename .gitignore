# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets - NEVER COMMIT CREDENTIALS
.env
.env.*
*.key
*.pem
*.secret
credentials*
secrets*
tokens*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Testing and coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Local database, runtime state, and run logs
state/*.json
state/*.db
state/*.lock
!state/*.py
cache/
data/*.db
data/*.sqlite
data/*.json
data/*.tmp
data/*.pid
data/*.trigger
data/*.lock
logs/*.log
logs/*.jsonl
!logs/audit_logger.py

